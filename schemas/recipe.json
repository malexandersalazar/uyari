{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uyari/recipe.json",
  "title": "recipes/*.yaml: one training run",
  "type": "object",
  "required": ["id", "build", "task", "language", "base_model", "method", "train", "output"],
  "anyOf": [{"required": ["primary"]}, {"required": ["primaries"]}],
  "properties": {
    "id": {"type": "string"},
    "build": {"type": "string", "pattern": "^data-[0-9]{4}\\.[0-9]{2}(-[a-z0-9]+)?$"},
    "task": {"enum": ["mt", "asr", "tts"]},
    "language": {"type": "string", "pattern": "^[a-z]{3}_[A-Z][a-z]{3}$"},
    "primary": {"type": "string", "pattern": "^[a-z]{3}_[A-Z][a-z]{3}$"},
    "primaries": {"type": "array", "minItems": 1, "uniqueItems": true,
                  "items": {"type": "string", "pattern": "^[a-z]{3}_[A-Z][a-z]{3}$"},
                  "description": "Official languages paired with the Indigenous one (e.g. [spa_Latn, eng_Latn]): one model, every direction"},
    "directions": {"type": "array", "items": {"type": "string", "pattern": "^[a-z]{3}>[a-z]{3}$"}},
    "splits": {
      "type": "object",
      "properties": {"train": {"const": "train"}, "validation": {"const": "validation"}},
      "additionalProperties": false
    },
    "filters": {
      "type": "object",
      "properties": {
        "provenance": {"type": "array", "items": {"type": "string"}},
        "licenses": {"type": "array", "items": {"type": "string"}}
      }
    },
    "base_model": {"type": "string"},
    "method": {"enum": ["seq2seq", "qlora"]},
    "lora": {"type": "object"},
    "text_codec": {"type": "object", "additionalProperties": {"type": "string"}},
    "new_lang_token_init": {"type": "string"},
    "train": {"type": "object"},
    "eval": {"type": "object"},
    "output": {"type": "string", "pattern": "^models/[a-z0-9.\\-]+@v[0-9]+\\.[0-9]+$"},
    "notes": {"type": "string"}
  }
}
