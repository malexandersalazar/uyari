{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uyari/takedown.json",
  "title": "Takedown row (contributing/takedowns.csv)",
  "x-columns": ["contribution", "requested_by_role", "request_date", "effective_date", "scope", "note"],
  "type": "object",
  "required": ["contribution", "requested_by_role", "request_date", "effective_date", "scope"],
  "properties": {
    "contribution": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}_[a-z0-9]+_[0-9]{4}$"},
    "requested_by_role": {"enum": ["steward", "community_authority", "contributor", "maintainer"]},
    "request_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "effective_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "scope": {"enum": ["contribution", "audio", "text"]},
    "note": {"type": "string"}
  }
}
