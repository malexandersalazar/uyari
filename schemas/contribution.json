{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uyari/contribution.json",
  "title": "languages/<lang>/contributions/<id>/contribution.yaml",
  "type": "object",
  "required": ["id", "language", "variety", "contributor_id", "organization", "collection_dates",
    "provenance", "license", "consent", "compensated"],
  "properties": {
    "id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}_[a-z0-9]+_[0-9]{4}$"},
    "language": {"type": "string", "pattern": "^[a-z]{3}_[A-Z][a-z]{3}$"},
    "variety": {"type": "string"},
    "contributor_id": {"type": "string", "pattern": "^c-[0-9]{4}$"},
    "organization": {"type": "string"},
    "collection_dates": {
      "type": "object", "required": ["start", "end"],
      "properties": {"start": {"type": "string"}, "end": {"type": "string"}}
    },
    "provenance": {
      "type": "object", "required": ["text", "audio"],
      "properties": {
        "text": {"enum": ["human", "human_post_edited_from_mt", "imported", "none"]},
        "audio": {"enum": ["field_recording", "studio", "imported", "none"]}
      }
    },
    "license": {"enum": ["cc0", "cc-by-4.0", "cc-by-sa-4.0", "cc-by-nc-4.0", "community", "TODO"]},
    "consent": {
      "type": "object", "required": ["template", "authority"],
      "properties": {"template": {"type": "string"}, "authority": {"type": "string"}}
    },
    "compensated": {"enum": ["yes", "no", "TODO"]},
    "source_primary": {"type": "string"},
    "fixture": {"type": "boolean"},
    "notes": {"type": "string"}
  }
}
