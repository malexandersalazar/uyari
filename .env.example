# Copy to .env (gitignored). Never commit real keys.
META_API_URL=https://api.meta.ai/v1/responses
META_API_KEY=
# Muse Voice Transcribe one-shot endpoint (confirmed 2026-11-02); only override if Meta moves it
# META_TRANSCRIBE_URL=https://api.meta.ai/v1/asr/transcribe
# Local OpenAI-compatible server started by `uyari serve start` (vLLM or llama-server)
GLIMMER_LOCAL_URL=http://127.0.0.1:8011/v1/chat/completions
GLIMMER_MODEL_ID=meta-models/Muse-Glimmer-30B
# Force UTF-8 everywhere (Windows consoles default to cp1252 and break the Shawi apostrophe U+02BC)
PYTHONUTF8=1
